{
  "name": "linxtools-nuxt4",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Portal da Operação em Nuxt 4, Vue 3, TypeScript e API Nitro",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3000",
    "start": "node .output/server/index.mjs",
    "postinstall": "node scripts/prepare-tinymce.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --import tsx --test tests/*.test.mjs",
    "create:admin": "tsx scripts/create-admin.mjs",
    "migrate:supabase": "tsx scripts/migrate-to-supabase.mjs"
  },
  "dependencies": {
    "@tinymce/tinymce-vue": "^6.3.0",
    "nuxt": "^4.2.0",
    "sanitize-html": "^2.18.1",
    "tinymce": "^8.10.0",
    "tinymce-i18n": "^26.9.28",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
