# Configuração opcional. O projeto funciona com estas configurações padrão.
PORT=3000
HOST=127.0.0.1
DATA_PROVIDER=local

# Ao migrar o armazenamento para Supabase:
# DATA_PROVIDER=supabase
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_PRIVADA
# A service_role NUNCA deve ser exposta no frontend.
# Use HTTPS e um proxy confiável em produção.
